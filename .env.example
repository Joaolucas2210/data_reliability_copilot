# Copy to .env for local overrides. Defaults match docker-compose.yml + infra/local/init.sql (LOCAL-ONLY secrets).
# Never put real credentials in this file or in the repo; cloud envs read them from Key Vault (docs/operations/cloud-runbook.md).
DRC_PG_HOST=localhost
DRC_PG_PORT=55432
# DRC_ADMIN_PASSWORD=local-admin-only
# DRC_DBT_PROD_PASSWORD=dbt-local-only
# DRC_READER_PASSWORD=reader-local-only
# DRC_APP_PASSWORD=app-local-only
# DRC_SANDBOX_PASSWORD=sandbox-local-only
DRC_LLM_PROVIDER=fake            # fake | anthropic
# DRC_LLM_MODEL=claude-opus-5-5  # used when provider=anthropic; needs ANTHROPIC_API_KEY or `ant auth login`
# DRC_LLM_FALLBACK_MODEL=        # explicit, logged fallback; off by default
# DRC_MARQUEZ_URL=http://localhost:5000   # set when `make up-lineage` is running
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318  # set when `make up-obs` is running
DRC_AUTH_MODE=dev
